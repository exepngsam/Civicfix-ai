# ========================================================
# CIVICFIX AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# When left blank or unconfigured, the application runs in
# zero-config "DEMO MODE: LOCAL" with realistic simulated latency
# and mock telemetry for instant hackathon evaluation.
#
# To connect to live AWS services, fill in the values below:
# ========================================================

# AWS Deployment Region
VITE_AWS_REGION=us-east-1

# Amazon Bedrock Foundation Model Identifier
# (e.g. anthropic.claude-3-5-sonnet-20241022-v2:0 or amazon.titan-embed-image-v1)
VITE_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon S3 Evidence Storage Bucket Name
VITE_S3_BUCKET=civicfix-evidence-production

# Amazon DynamoDB Table Name for Civic Reports Registry
VITE_DYNAMODB_TABLE=CivicFixReports

# Amazon OpenSearch Domain Endpoint for k-NN Vector Search
VITE_OPENSEARCH_ENDPOINT=https://search-civicfix-vectors.us-east-1.es.amazonaws.com

# Amazon API Gateway Base URL (Generated by AWS SAM deployment)
VITE_API_BASE_URL=

# Amazon Cognito User Pool ID & Client ID
VITE_COGNITO_USER_POOL_ID=us-east-1_civicfix98x
VITE_COGNITO_CLIENT_ID=7k89civicfixclient
